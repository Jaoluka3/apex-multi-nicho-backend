# n8n local configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# Generate strong random values before starting the stack.
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD

# Supplier discovery
FIRECRAWL_API_KEY=
DISCOVERY_RESULTS_PER_QUERY=3

# OpenAI-compatible provider (OpenAI, NVIDIA NIM, OpenRouter, etc.)
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=

# Supabase server-only credentials. Never expose service_role in the storefront.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

